<%# app/views/shared/_pagination.html.erb %>
<% paginator ||= local_assigns[:paginator] || @paginator %>

<% if paginator.present? && paginator.total_pages > 1 %>
  <nav id="pagination" aria-label="Pagination" class="flex items-center justify-between border-t border-slate-200 bg-white px-4 py-3 sm:px-6">

    <%# Mobile Navigation: Simple Prev/Next %>
    <div class="flex flex-1 justify-between sm:hidden">
      <% if paginator.prev_page %>
        <%= link_to url_for(request.query_parameters.merge(page: paginator.prev_page)), class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" do %>
          Previous
        <% end %>
      <% else %>
        <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-4 py-2 text-sm font-medium text-slate-400 cursor-not-allowed">Previous</span>
      <% end %>

      <% if paginator.next_page %>
        <%= link_to url_for(request.query_parameters.merge(page: paginator.next_page)), class: "ml-3 inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" do %>
          Next
        <% end %>
      <% else %>
        <span class="ml-3 inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-4 py-2 text-sm font-medium text-slate-400 cursor-not-allowed">Next</span>
      <% end %>
    </div>

    <%# Desktop Navigation %>
    <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-center">
      <div class="mr-3">
        <p class="text-sm text-slate-700">
        Showing 
        <span class="font-semibold text-slate-900"><%= paginator.offset + 1 %></span>
        to 
        <span class="font-semibold text-slate-900"><%= [paginator.offset + paginator.per_page, paginator.total_count].min %></span>
        of 
        <span class="font-semibold text-slate-900"><%= paginator.total_count %></span> results
        </p>
      </div>

      <div>
        <div class="isolate inline-flex -space-x-px rounded-md shadow-xs" aria-label="Pagination Controls">

          <%# Previous Button %>
          <% if paginator.prev_page %>
            <%= link_to url_for(request.query_parameters.merge(page: paginator.prev_page)), class: "relative inline-flex items-center rounded-l-md px-2 py-2 text-slate-400 ring-1 ring-slate-300 ring-inset hover:bg-slate-50 focus:z-20 focus:outline-offset-0" do %>
              <span class="sr-only">Previous</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
              </svg>
            <% end %>
          <% else %>
            <span class="relative inline-flex items-center rounded-l-md px-2 py-2 text-slate-300 ring-1 ring-slate-200 ring-inset bg-slate-50 cursor-not-allowed">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
              </svg>
            </span>
          <% end %>

          <%# Page Numbers & Ellipses %>
          <% paginator.page_range.each do |item| %>
            <% if item == :gap %>
              <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-300 ring-inset">...</span>
            <% elsif item == paginator.current_page %>
              <span aria-current="page" class="relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                <%= item %>
              </span>
            <% else %>
              <%= link_to item, url_for(request.query_parameters.merge(page: item)), class: "relative inline-flex items-center px-4 py-2 text-sm font-semibold text-slate-900 ring-1 ring-slate-300 ring-inset hover:bg-slate-50 focus:z-20 focus:outline-offset-0" %>
            <% end %>
          <% end %>

          <%# Next Button %>
          <% if paginator.next_page %>
            <%= link_to url_for(request.query_parameters.merge(page: paginator.next_page)), class: "relative inline-flex items-center rounded-r-md px-2 py-2 text-slate-400 ring-1 ring-slate-300 ring-inset hover:bg-slate-50 focus:z-20 focus:outline-offset-0" do %>
              <span class="sr-only">Next</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            <% end %>
          <% else %>
            <span class="relative inline-flex items-center rounded-r-md px-2 py-2 text-slate-300 ring-1 ring-slate-200 ring-inset bg-slate-50 cursor-not-allowed">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          <% end %>

        </div>
      </div>
    </div>
  </nav>
<% end %>
