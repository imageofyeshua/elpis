<% title ||= "Are you sure?" %>
<% cancel_text ||= "Cancel" %>
<% confirm_text ||= "Confirm" %>

<dialog id="turbo-confirm-dialog" class="fixed inset-0 m-auto backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm rounded-xl p-0 max-w-md w-full shadow-2xl transition-all duration-200">
  <div class="p-6">
    <div class="flex items-center space-x-3 text-red-600 mb-2">
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <h3 class="text-lg font-semibold text-slate-900"><%= title %></h3>
    </div>
    
    <p id="turbo-confirm-message" class="text-slate-600 text-sm mb-6"></p>

    <div class="flex justify-end gap-3">
      <button id="turbo-confirm-cancel" type="button" class="px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-lg hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-300">
        <%= cancel_text %>
      </button>
      <button id="turbo-confirm-accept" type="button" class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm">
        <%= confirm_text %>
      </button>
    </div>
  </div>
</dialog>
