<div id="micropost-<%= micropost.id %>" class="flex">
  <div class="w-30 pt-3">
    <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>
  </div>
  <div class="w-60 my-1 border-t border-gray-200 py-1">
    <div class="text-sm text-slate-600"><%= link_to micropost.user.name, micropost.user %></div>
    <div class="text-slate-900"><%= micropost.content.truncate(24) %></div>
    <div class="text-sm text-slate-500">
      [Posted <%= time_ago_in_words(micropost.created_at) %> ago.]
    </div>
  </div>
  <div class="px-3 py-8 text-sm font-medium text-red-800 hover:text-red-600">
      <% if current_user?(micropost.user) %>
        <%= link_to "delete", micropost, data: { "turbo-method": :delete, turbo_confirm: "This action cannot be undone. Are you sure?" } %>
      <% end %>
  </div>
</div>
