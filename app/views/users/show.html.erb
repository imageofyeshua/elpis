<% provide(:title, @user.name) %>
<div class="ml-24">
  <%= link_to edit_user_path(@user) do %>
    <div class="flex flex-row gap-3 text-xl">
      <%= gravatar_for @user %>
      <span class="hover:text-blue-700"><%= @user.name %></span>
    </div>
  <% end %>
  <div class="mx-auto">
    <%= render partial: "shared/pagination", locals: { pagination: @pagination } %>
    <% if @user.microposts.any? %> 
      <div class="my-3 text-xl"><%= pluralize(@user.microposts.count, "micropost") %></div>
      <ol class="microposts">
        <%= render @microposts %> 
      </ol>
    <% end %>
    <%= render partial: "shared/pagination", locals: { pagination: @pagination } %>
  </div>
</div>
