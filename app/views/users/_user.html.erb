<li class="flex justify-between gap-x-6 py-5">
  <div class="flex min-w-0 gap-x-4">
    <%= gravatar_for user, size: 50 %>
    <div class="min-w-0 flex-auto">
      <% if user.email == current_user.email %>
        <p class="text-sm/6 font-semibold text-gray-900"><%= link_to user.name, current_user %></p>
        <p class="mt-1 truncate text-xs/5 text-gray-500"><%= link_to user.email %></p>
      <% else %>
        <p class="text-sm/6 font-semibold text-gray-900"><%= user.name %></p>
        <p class="mt-1 truncate text-xs/5 text-gray-500"><%= user.email %></p>
      <% end %>
    </div>
  </div>
  <div class="hidden shrink-0 sm:flex sm:flex-col sm:items-end">
    <% if user.admin? %>
      <p class="text-sm/6 font-semibold text-blue-900">Admin</p>
    <% elsif current_user.admin? && !current_user?(user) %>
      <%= link_to "DELETE", user, class: "text-sm/6 font-semibold text-red-900 hover:text-red-400", data: { "turbo-method": :delete, turbo_confirm: "You sure?" } %>
    <% end %>
    <p class="mt-1 text-xs/5 text-gray-500">Registered at <%= user.created_at %></p>
  </div>
</li>
