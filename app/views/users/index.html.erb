<% provide(:title, 'All users') %>

<div class="flex flex-col items-center">
  <h1>All users</h1>
  <ul role="list" class="divide-y divide-gray-100">
    <% @users.each do |user| %>
      <li class="flex justify-between gap-x-6 py-5">
        <div class="flex min-w-0 gap-x-4">
          <%= gravatar_for user, size: 50 %>
          <div class="min-w-0 flex-auto">
            <p class="text-sm/6 font-semibold text-gray-900"><%= link_to user.name %></p>
            <p class="mt-1 truncate text-xs/5 text-gray-500"><%= link_to user.email %></p>
          </div>
        </div>
        <div class="hidden shrink-0 sm:flex sm:flex-col sm:items-end">
          <p class="text-sm/6 text-gray-900">Co-Founder / CEO</p>
          <p class="mt-1 text-xs/5 text-gray-500">Last seen <time datetime="2023-01-23T13:23Z">3h ago</time></p>
        </div>
      </li>
    <% end %>
  </ul>
</div>

