<% provide(:title, "Edit user") %>
<% provide(:button_text, "Save changes") %>
<div class="max-w-md mx-auto mt-10 bg-white p-8 border border-gray-200 rounded-lg shadow-md">
  <h2 class="text-2xl font-bold mb-6 text-gray-800">Update your profile</h2>
  <%= render 'form' %>
  <div class="flex flex-row w-full items-center gap-2 mt-3">
    <%= gravatar_for @user %> 
    <%= link_to 'change', 'https://gravatar.com/emails', target: '_blank', rel: 'noopener' %>
  </div>
</div>

