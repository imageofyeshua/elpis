<section id="shorten" class="relative bg-gray-100">
  <!-- Shorten Container -->
  <div class="max-w-4xl mx-auto p-6 space-y-6">
    <!-- Form -->
    <%= form_with(url: "/", local: true, data: {
      controller: "form-validation",
      action: "submit->form-validation#validate"
    }) do |form| %>
      <div id="link-form" class="relative flex flex-col w-full p-10 -mt-20 space-y-4 bg-dark-violet rounded-lg md:flex-row md:space-y-0 md:space-x-3">
        <%= form.text_field :link,
          id: "link-input",
          data: { action: "input->form-validation#clear" },
          placeholder: "Shorten a link here",
          class: "flex-1 p-3 border-2 bg-white rounded-lg placeholder-yellow-500 focus:outline-none" %>
        <!-- Error Message -->
        <div id="err-msg" class="absolute left-7 bottom-3 text-red-600 hidden text-sm italic"></div>
        <%= form.submit "ShortenIt!", class: "px-10 py-3 text-white bg-cyan rounded-lg hover:bg-cyan-light focus:outline-none md:py-2" %>
      </div>
    <% end %>
    <!-- Link 1 -->
    <div class="flex flex-col items-center justify-between w-full p-6 bg-white founded-lg md:flex-row">
      <p class="font-bold text-center text-very-dark-violet md:text-left">
      https://frontendmentor.io
      </p> 
      <div class="flex flex-col items-center justify-end flex-1 space-x-4 space-y-2 md:flex-row md:space-y-0">
        <div class="font-bold text-cyan">
          https://rel.link/k4IKyk 
        </div> 
        <button class="p-2 px-8 text-white bg-cyan rounded-lg hover:opacity-70 focus:outline-none">Copy</button>
      </div>
    </div>
    <!-- Link 2 -->
    <div class="flex flex-col items-center justify-between w-full p-6 bg-white founded-lg md:flex-row">
      <p class="font-bold text-center text-very-dark-violet md:text-left">
      https://twitter.com/frontendmentor.io
      </p> 
      <div class="flex flex-col items-center justify-end flex-1 space-x-4 space-y-2 md:flex-row md:space-y-0">
        <div class="font-bold text-cyan">
          https://rel.link/g8KNyk 
        </div> 
        <button class="p-2 px-8 text-white bg-dark-violet rounded-lg hover:opacity-70 focus:outline-none">Copy</button>
      </div>
    </div>
    <!-- Link 3 -->
    <div class="flex flex-col items-center justify-between w-full p-6 bg-white founded-lg md:flex-row">
      <p class="font-bold text-center text-very-dark-violet md:text-left">
      https://linkedin.com/frontendmentor.io
      </p> 
      <div class="flex flex-col items-center justify-end flex-1 space-x-4 space-y-2 md:flex-row md:space-y-0">
        <div class="font-bold text-cyan">
          https://rel.link/gobLLmx 
        </div> 
        <button class="p-2 px-8 text-white bg-cyan rounded-lg hover:opacity-70 focus:outline-none">Copy</button>
      </div>
    </div>
  </div>
</section>
