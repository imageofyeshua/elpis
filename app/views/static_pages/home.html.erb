<div class="my-12 mx-36">
  <% if logged_in? %>
    <div class="flex my-7">
      <div class="w-1/2">
        <section>
          <%= render 'shared/user_info' %>
        </section>
        <section>
          <%= render 'shared/micropost_form' %>
        </section>
      </div>
      <div class="w-1/2">
        <div class="mb-3 text-xl text-shadow-blue-900">Micropost Feed</div>
        <%= render 'shared/feed' %>
      </div>
    </div>
  <% else %>
    <div class="py-5">
      <%= link_to "Signup now!", signup_path, class: "bg-blue-400 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>
</div>
