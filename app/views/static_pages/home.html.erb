<div class="my-36 mx-36">
  <h1 class="text-4xl text-blue-700 font-josefin">Home</h1>
  <p class="font-alata text-3xl">Abide in Hope Scripture Application</p>

  <% if logged_in? %>
    <div class="flex my-7">
      <div class="w-1/2">
        <section>
          <%= render 'shared/user_info' %>
        </section>
        <section>
          <%= render 'shared/micropost_form' %>
        </section>
      </div>
      <div class="w-1/2">
        <h3>Micropost Feed</h3>
        <%= render 'shared/feed' %>
      </div>
    </div>
  <% else %>
    <div class="py-5">
      <%= link_to "Signup now!", signup_path, class: "bg-blue-400 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>
</div>
