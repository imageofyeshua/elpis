<div class="my-12 mx-36">
  <% if logged_in? %>
    <div class="flex my-7">
      <div class="w-1/2">
        <section>
          <%= render 'shared/user_info' %>
        </section>
        <section>
          <%# render 'shared/stats' %>
        </section>
        <section>
          <%= render 'shared/micropost_form' %>
        </section>
      </div>
      <div class="w-1/2">
        <div class="mb-3 text-xl text-shadow-blue-900">Micropost Feed</div>
        <%= render 'shared/feed' %>
      </div>
    </div>
  <% else %>
      <h1 class="text-4xl text-blue-700 font-josefin">Home</h1>
      <p class="mb-5 font-alata text-3xl">Welcome to the Ark of Wisdom</p>
      <%= link_to "Signup now!", signup_path, class: "bg-blue-400 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded" %>
  <% end %>
</div>
