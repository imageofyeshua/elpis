<% provide(:title, "About") %>
<section id="hero">
  <div class="container max-w-6xl mx-auto px-6 py-12">
    <nav class="flex items-center justify-between font-bold text-white">
      <%= image_tag "logo.svg" %>
      <div class="hidden h-10 font-alata md:flex md:space-x-8">
        <div class="group">
          <%= link_to "About", "/about" %>
          <div class="mx-2 group-hover:border-b group-hover:border-blue-50">
          </div>
        </div> 
        <div class="group">
          <%= link_to "Careers", "/about" %>
          <div class="mx-2 group-hover:border-b group-hover:border-blue-50">
          </div>
        </div> 
        <div class="group">
          <%= link_to "Products", "/about" %>
          <div class="mx-2 group-hover:border-b group-hover:border-blue-50">
          </div>
        </div> 
        <div class="group">
          <%= link_to "Events", "/about" %>
          <div class="mx-2 group-hover:border-b group-hover:border-blue-50">
          </div>
        </div> 
        <div class="group">
          <%= link_to "Support", "/about" %>
          <div class="mx-2 group-hover:border-b group-hover:border-blue-50">
          </div>
        </div> 
        <!-- Hamburger Button -->
      </div>
    </nav>
    <!-- Mobile Menu -->
    <div class="max-w-lg mt-32 mb-32 p-4 font-sans text-4xl text-white uppercase border-2 md:p-10 md:m-32 md:mx-0 md:text-6xl">
      Impressive Experience That Deliver
    </div>
  </div>
</section>
<section id="feature">
  <div class="relative container flex flex-col max-w-6xl mx-auto my-32 px-6 text-gray-900 md:flex-row md:px-0">
    <%= image_tag "desktop/image-interactive.jpg" %>
    <div class="top-48 pr-0 bg-white md:absolute md:right-0 md:py-20 md:pl-20">
      <h2 class="max-w-lg mt-10 mb-6 font-sans text-4xl text-center text-gray-900 uppercase md:text-5xl md:mt-0 md:text-left">
        The Leader in Interactive VR
      </h2> 
      <p class="max-w-md text-center md:text-left">
      Founded in 2011, Loopstudios has been producing world-class virtual reality projects for some of the best companies around the globe. Our award-winning creations have transformed businesses through digital experiences that bind to their brand.
      </p>
    </div>
  </div>
</section>
<<section id="creations">
  <div class="container max-w-6xl mx-auto my-32 px-6 text-gray-900 md:px-0">
    <div class="flex justify-center mb-20 md:justify-between">
      <h2 class="text-4xl text-center uppercase md:text-left md:text-5xl">
        Our Creations
      </h2> 
      <button class="hidden btn tracking-widest md:block">
        See All
      </button>
    </div> 
    <div class="item-container">
      <div class="group item">
        <%= image_tag "desktop/image-deep-earth.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-deep-earth.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>Deep Earth</h5>
      </div> 
      <div class="group item">
        <%= image_tag "desktop/image-night-arcade.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-night-arcade.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>Night Arcade</h5>
      </div> 
      <div class="group item">
        <%= image_tag "desktop/image-soccer-team.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-soccer-team.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>Soccer Team VR</h5>
      </div> 
      <div class="group item">
        <%= image_tag "desktop/image-grid.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-grid.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>The Grid</h5>
      </div> 
    </div>
    <div class="item-container mt-10">
      <div class="group item">
        <%= image_tag "desktop/image-from-above.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-from-above.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>From Above</h5>
      </div> 
      <div class="group item">
        <%= image_tag "desktop/image-pocket-borealis.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-pocket-borealis.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>Pocket Borealis</h5>
      </div> 
      <div class="group item">
        <%= image_tag "desktop/image-curiosity.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-curiosity.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>Curiosity</h5>
      </div> 
      <div class="group item">
        <%= image_tag "desktop/image-fisheye.jpg", class: "hidden w-full duration-200 md:block group-hover:scale-110" %>
        <%= image_tag "mobile/image-fisheye.jpg", class: "w-full md:hidden" %>
        <div class="item-gradient">
        </div>
        <h5>Make It Fisheye</h5>
      </div> 
    </div>
    <div class="flex justify-center mt-10 md:hidden">
      <button class="btn tracking-widest w-full md:hidden">See All</button> 
    </div>
  </div> 
</section>
