<nav class="relative container mx-auto p-6">
  <!-- Flex Container For All Items -->
  <div class="flex items-center justify-between">
    <!-- Flex Container For Logo/Menu -->
    <div class="flex items-center space-x-8">
      <!-- Logo -->
      <%= link_to root_path do %>
        <%= image_tag "logo_elpis.svg", class: "h-15" %>
      <% end %>
      <!-- Left Menu -->
      <div class="hidden space-x-5 font-bold lg:flex">
        <%= link_to "Home", root_path, class: "text-grayish-violet hover:text-very-dark-violet" %>
        <%= link_to "About", about_path, class: "text-grayish-violet hover:text-very-dark-violet" %>
      </div>
    </div>
    <!-- Right Buttons Menu -->
    <div class="hidden items-center space-x-5 font-bold text-grayish-violet lg:flex">
      <% if logged_in? %>
        <div data-controller="dropdown" data-dropdown-active-class="hidden" class="relative inline-block text-left">
          <div>
            <button data-action="click->dropdown#toggle click@window->dropdown#hide" 
                    type="button" 
                    class="inline-flex w-full justify-center gap-x-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" 
                    id="menu-button" 
                    aria-expanded="true" 
                    aria-haspopup="true">
                    Account
                    <svg class="-mr-1 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                    </svg>
            </button>
          </div>

          <div data-dropdown-target="menu" 
               class="hidden absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-gray-400 ring-opacity-5 focus:outline-none" 
               role="menu" 
               aria-orientation="vertical" 
               aria-labelledby="menu-button" 
               tabindex="-1">
            <div class="py-1" role="none">
              <li class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                <%= link_to "Profile", current_user %>
              </li>
              <li class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                <%= link_to "Settings", root_path %>
              </li>
              <li class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                <%= link_to "Log out", logout_path, data: { "turbo-method": :delete } %>
              </li>
            </div>
          </div>
        </div>
      <% else %>
        <%= link_to "Login", login_path, class: "px-8 py-3 font-bold text-white bg-cyan rounded-full hover:opacity-70" %>
      <% end %>
    </div>
    <!-- Hamburger Button -->
    <div data-controller="toggle" class="md:hidden">
      <button data-toggle-target="button" data-action="click->toggle#toggle" id="menu-btn" type="button" class="z-40 block hamburger md:hidden focus:outline-none">
        <span class="hamburger-top"></span>
        <span class="hamburger-middle"></span>
        <span class="hamburger-bottom"></span>
      </button> 
      <!-- Mobile Menu -->
      <div data-toggle-target="menu" class="absolute hidden p-6 rounded-lg bg-dark-violet left-6 right-6 top-20 z-100">
        <div class="flex flex-col items-center justify-center w-full space-y-6 font-bold text-white rounded-sm">
          <%= link_to "Home", root_path, class: "w-full text-center" %>
          <%= link_to "About", about_path, class: "w-full text-center" %>
          <% if logged_in? %>
            <%= link_to "Profile", current_user, class: "w-full pt-6 border-t  border-gray-400 text-center" %>
            <%= link_to "Settings", root_path, class: "w-full text-center" %>
          <% else %>
            <%= link_to "Login", login_path, class: "w-full pt-6 border-t  border-gray-400 text-center" %>
            <%= link_to "Sign Up", signup_path, class: "w-full py-3 text-center rounded-full bg-cyan" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>
