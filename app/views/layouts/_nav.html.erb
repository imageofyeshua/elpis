<nav class="relative container mx-auto p-6">
  <!-- Flex Container For All Items -->
  <div class="flex items-center justify-between">
    <!-- Flex Container For Logo/Menu -->
    <div class="flex items-center space-x-8">
      <!-- Logo -->
      <%= image_tag "logo_elpis.svg", class: "h-15" %>
      <!-- Left Menu -->
      <div class="hidden space-x-5 font-bold lg:flex">
        <%= link_to "Home", root_path, class: "text-grayish-violet hover:text-very-dark-violet" %>
        <%= link_to "About", static_pages_about_path, class: "text-grayish-violet hover:text-very-dark-violet" %>
        <%= link_to "Help", static_pages_help_path, class: "text-grayish-violet hover:text-very-dark-violet" %>
      </div>
    </div>
    <!-- Right Buttons Menu -->
    <div class="hidden items-center space-x-5 font-bold text-grayish-violet lg:flex">
      <%= link_to "Login", "/", class: "px-8 py-3 font-bold text-white bg-cyan rounded-full hover:opacity-70" %>
    </div>
      <!-- Hamburger Button -->
      <div data-controller="toggle" class="md:hidden">
        <button data-toggle-target="button" data-action="click->toggle#toggle" id="menu-btn" type="button" class="z-40 block hamburger md:hidden focus:outline-none">
          <span class="hamburger-top"></span>
          <span class="hamburger-middle"></span>
          <span class="hamburger-bottom"></span>
        </button> 
        <!-- Mobile Menu -->
        <div data-toggle-target="menu" class="absolute hidden p-6 rounded-lg bg-dark-violet left-6 right-6 top-20 z-100">
          <div class="flex flex-col items-center justify-center w-full space-y-6 font-bold text-white rounded-sm">
            <%= link_to "Home", "/", class: "w-full text-center" %>
            <%= link_to "Help", "/", class: "w-full text-center" %>
            <%= link_to "Login", "/", class: "w-full pt-6 border-t  border-gray-400 text-center" %>
            <%= link_to "Sign Up", "/", class: "w-full py-3 text-center rounded-full bg-cyan" %>
          </div>
        </div>
      </div>
  </div>
</nav>
