<footer class="w-full py-16 bg-very-dark-violet">
  <div class="container flex flex-col items-center justify-between mx-auto space-y-16 md:flex-row md:space-y-0 md:items-start">
    <!-- Menus Container -->
    <div class="flex flex-col space-y-6 md:space-x-20 md:flex-row md:space-y-0">
      <!-- Menus 1 -->
      <div class="flex flex-col items-center w-full md:items-start">
        <div class="mb-5 font-bold text-white capitalize">
          Features 
        </div>
        <div class="flex flex-col items-center space-y-3 md:items-start">
          <%= link_to "Blog", "/", class: "capitalize text-grayish-violet hover:text-cyan" %>
          <%= link_to "Support", "/", class: "capitalize text-grayish-violet hover:text-cyan" %>
        </div>
      </div>

      <!-- Menus 2 -->
      <div class="flex flex-col items-center w-full md:items-start">
        <div class="mb-5 font-bold text-white capitalize">
          Resources 
        </div>
        <div class="flex flex-col items-center space-y-3 md:items-start">
          <%= link_to "Our Team", "/", class: "capitalize text-grayish-violet hover:text-cyan" %>
          <%= link_to "Careers", "/", class: "capitalize text-grayish-violet hover:text-cyan" %>
        </div>
      </div>

      <!-- Menus 3 -->
      <div class="flex flex-col items-center w-full md:items-start">
        <div class="mb-5 font-bold text-white capitalize">
          Company 
        </div>
        <div class="flex flex-col items-center space-y-3 md:items-start">
          <%= link_to "About", about_path, class: "capitalize text-grayish-violet hover:text-cyan" %>
          <%= link_to "Contact", contact_path, class: "capitalize text-grayish-violet hover:text-cyan" %>
        </div>
      </div>
    </div>

    <!-- Social Container -->
    <div class="flex space-x-6">
      <%= link_to image_tag("icon-facebook.svg", alt: "Facebook", class: "ficon"), root_path %>
      <%= link_to image_tag("icon-twitter.svg", alt: "Twitter", class: "ficon"), root_path %>
      <%= link_to image_tag("icon-pinterest.svg", alt: "Pinterest", class: "ficon"), root_path %>
      <%= link_to image_tag("icon-instagram.svg", alt: "Instagram", class: "ficon"), root_path %>
    </div>
  </div>
</footer>
